# Автоматически создаваемые папки при работе с кодом
bin/
obj/

# Временные файлы и бэкапы (Auto-save)
*.asv
*.m~

# Файлы настроек пользователя (содержат пути, открытые вкладки и т.д.)
# Обычно их не стоит пушить, так как они специфичны для вашего ПК
matlab.mat
*.mex* 
*.slxc
*.mexw32
*.mexw64
*.mexmaci64
*.mexa64

# Кэш симуляций и Simulink
slprj/
*_ert_rtw/
*_grt_rtw/
*.slxc
*.simlog

# Профилировщик и логи компиляции
*.mlappinstall
*.p
*.log

# App Designer (временные файлы сборки)
*.bak-mlapp

# Результаты тестов и отчеты
test_results/
html/

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*.cache